+// The transmitter accepts a byte whenever the holding buffer has room. CTS decides when a held
+// byte reaches the wire, not whether the program may write one: refusing the write stalls a
+// program that polls TXRDY before every byte, and dropping it destroys traffic outright.
+void PCSX::SIO1::updateTxReady() {
+    if (m_txHold.size() < kTxHoldDepth) {
+        m_regs.status |= (SR_TXRDY | SR_TXRDY2);
+    } else {
+        m_regs.status &= ~(SR_TXRDY | SR_TXRDY2);
+    }
+}
+
+// The peer asserts RTS only while it is inside a read call, so CTS marks the window in which the
+// far end is actually listening. Releasing held bytes exactly then preserves write ordering and
+// keeps them out of a receive FIFO that has no read armed to consume them.
+void PCSX::SIO1::flushTxHold() {
+    while (!m_txHold.empty() && (m_regs.status & SR_CTS)) {
+        m_regs.data = m_txHold.front();
+        m_txHold.pop_front();
+        transmitData();
+    }
+    updateTxReady();
+}
