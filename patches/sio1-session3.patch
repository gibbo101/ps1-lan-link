+// Retaliation's link driver keeps the DSR level it last acted on at 0x801F85E8 and advances
+// only when the live DSR differs from it. Reading emulated RAM directly (rather than inferring
+// from the program counter, which the dynarec reports per-block) shows exactly which level each
+// side latched and when, against the DSR it was actually seeing.
+void PCSX::SIO1::watchLinkBaseline() {
+    uint8_t *wram = g_emulator->m_mem->m_wram;
+    if (!wram) return;
+    uint32_t w[4], r[4];
+    memcpy(w, wram + (kLinkStateAddr & 0x1fffff), sizeof(w));
+    memcpy(r, wram + (kReadStateAddr & 0x1fffff), sizeof(r));
+    bool dsr = m_regs.status & SR_DSR;
+    bool wChanged = memcmp(w, m_lastLinkState, sizeof(w)) != 0;
+    bool rChanged = memcmp(r, m_lastReadState, sizeof(r)) != 0;
+    if (!wChanged && !rChanged && dsr == m_lastLinkBaselineDsr) return;
+
+    // The block size gates every handshake: the writer waits for a DSR edge after this many
+    // bytes, and the reader toggles DTR after the same count.
+    uint16_t cfg = 0;
+    memcpy(&cfg, wram + (kLinkConfigAddr & 0x1fffff), sizeof(cfg));
+    uint32_t idx = (cfg & 0x300) >> 7;
+    int16_t block = 0;
+    memcpy(&block, wram + ((0x801ace30 + idx) & 0x1fffff), sizeof(block));
+
+    g_system->printf(
+        "SIO1-DIAG t=%10.3f cyc=%llu LINKSTATE WR[act=%08x buf=%08x cnt=%08x latch=%08x] "
+        "RD[act=%08x buf=%08x cnt=%08x] block=%d cfg=%04x DSR=%d DTR=%d stat=%04x ctrl=%04x fifo=%zu\n",
+        diagMs(), (unsigned long long)diagCycle(), w[0], w[1], w[2], w[3], r[0], r[1], r[2], block, cfg, dsr,
+        !!(m_regs.control & CR_DTR), m_regs.status, m_regs.control, m_sio1fifo ? m_sio1fifo->size() : 0);
+    memcpy(m_lastLinkState, w, sizeof(w));
+    memcpy(m_lastReadState, r, sizeof(r));
+    m_lastLinkBaselineDsr = dsr;
+}
+
+// A drain that consumes several messages in one poll applies all their line transitions
+// between two emulated instructions, so the game cannot observe any but the last.
+void PCSX::SIO1::logDrain() {
+    g_system->printf("SIO1-DIAG t=%10.3f cyc=%llu DRAIN %u messages in one poll\n", diagMs(),
+                     (unsigned long long)diagCycle(), m_msgsThisDrain);
+}
+
+// Status polling is the game's only view of DSR/CTS, so every read is counted, but only
+// changes in the observed value are printed.
+void PCSX::SIO1::logStatRead() {
+    watchLinkBaseline();
+    m_lastStatReadCycle = diagCycle();
+    m_statReads++;
+    if (m_regs.status & SR_DSR) m_statReadsWithDsr++;
+    if (m_regs.status & SR_CTS) m_statReadsWithCts++;
+
+    // Where the polling loop lives. Sampled, because this is a high-volume success event and the
+    // loop repeats from the same address; the change-triggered line below is the uncapped record.
+    if ((m_statReads & 0xfff) == 0) {
+        g_system->printf("SIO1-DIAG t=%10.3f cyc=%llu STAT poll sample pc=%08x stat=%04x reads=%u\n", diagMs(),
+                         (unsigned long long)diagCycle(), g_emulator->m_cpu->m_regs.pc, m_regs.status, m_statReads);
+    }
+
+    if (m_regs.status == m_lastLoggedStat && m_regs.control == m_lastLoggedStatCtrl) {
+        m_statRepeats++;
+        return;
+    }
+    g_system->printf(
+        "SIO1-DIAG t=%10.3f cyc=%llu game read STAT=%04x ctrl=%04x [DSR=%d CTS=%d RXRDY=%d] pc=%08x (prev value held "
+        "for %u reads) totalReads=%u\n",
+        diagMs(), (unsigned long long)diagCycle(), m_regs.status, m_regs.control, !!(m_regs.status & SR_DSR),
+        !!(m_regs.status & SR_CTS), !!(m_regs.status & SR_RXRDY), g_emulator->m_cpu->m_regs.pc, m_statRepeats,
+        m_statReads);
+    m_lastLoggedStat = m_regs.status;
+    m_lastLoggedStatCtrl = m_regs.control;
+    m_statRepeats = 0;
+}
