+#pragma once
+
+#include <uv.h>
+
+#include <cstdlib>
+
+namespace PCSX {
+
+namespace Uv {
+
+inline constexpr const char* c_loopbackAddress = "127.0.0.1";
+
+// Fills `addr` with the address every listening socket in the emulator binds to, and returns the
+// libuv result code. The web server, the GDB server and the SIO1 link listener all accept anything
+// that reaches them — they can read and write emulated memory, drive the pads, and write files —
+// so reaching them has to require access to the machine itself. Hence loopback by default.
+// PCSX_BIND_ADDRESS opts a trusted setup back out to a wider interface; a value that is not a valid
+// IPv4 address falls back to loopback rather than leaving the socket unbound.
+inline int makeBindAddress(unsigned port, sockaddr_in* addr) {
+    const char* host = std::getenv("PCSX_BIND_ADDRESS");
+    if ((host == nullptr) || (host[0] == 0)) host = c_loopbackAddress;
+    int result = uv_ip4_addr(host, port, addr);
+    if (result != 0) result = uv_ip4_addr(c_loopbackAddress, port, addr);
+    return result;
+}
+
+}  // namespace Uv
+
+}  // namespace PCSX
