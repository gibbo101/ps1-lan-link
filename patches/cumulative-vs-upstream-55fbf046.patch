+// Hands the frame that was just scanned out to the media stream, taken after vblank() so it is the
+// completed picture rather than the one being drawn. The screenshot is only read when a consumer is
+// attached, so an instance nobody is watching does no work here at all.
+void PCSX::Emulator::exportFrame() {
+    auto &stream = MediaStream::get();
+    stream.tick();
+    if (!stream.wants()) return;
+
+    GPU::ScreenShot screenshot;
+    try {
+        screenshot = m_gpu->takeScreenShot();
+    } catch (...) {
+        // The OpenGL backend has no headless screenshot path; a renderer that cannot supply one
+        // must not take the emulator down every frame.
+        return;
+    }
+    auto format = screenshot.bpp == GPU::ScreenShot::BPP_24 ? MediaStream::VideoFormat::RGB888
+                                                           : MediaStream::VideoFormat::BGR555;
+    stream.pushVideo(std::move(screenshot.data), screenshot.width, screenshot.height, format);
+}
