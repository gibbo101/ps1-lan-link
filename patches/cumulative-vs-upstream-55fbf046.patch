+// Milliseconds since the first diagnostic call, for merging the two instances' logs
+// into one timeline. Cycle counts order events within an instance; wall clock across them.
+double diagMs() {
+    static const auto start = std::chrono::steady_clock::now();
+    return std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - start).count();
+}
+
+// Volume ceiling for per-event logs, high enough that the handshake (order 100 events)
+// is never truncated.
+constexpr unsigned kDiagCap = 50000;
+
+// The wall-time bound spent waiting on a blocked peer, and the window that counts as "recently
+// polled SIO_STAT". Both must exceed the peer's round-trip latency: loopback needs microseconds,
+// a real LAN needs milliseconds. Tunable at runtime (PCSX_LINK_STALL_US / PCSX_LINK_POLL_CYCLES)
+// so the network case can be tuned without recompiling. Read once, on first use.
+unsigned linkStallUs() {
+    static const unsigned v = [] {
+        const char *e = std::getenv("PCSX_LINK_STALL_US");
+        return e && *e ? static_cast<unsigned>(std::strtoul(e, nullptr, 10)) : 400u;
+    }();
+    return v;
+}
+uint64_t pollingWindowCycles() {
+    static const uint64_t v = [] {
+        const char *e = std::getenv("PCSX_LINK_POLL_CYCLES");
+        return e && *e ? static_cast<uint64_t>(std::strtoull(e, nullptr, 10)) : 8000ull;
+    }();
+    return v;
+}
+
+// A peer that is connected but not transferring never answers, so every stall runs its budget out
+// in full. At a budget sized for a real network round trip that is nearly the whole wall clock, and
+// emulation crawls on screens that are not even linking yet — the program polls SIO_STAT on the
+// main menu simply to notice a partner. Waiting only earns its cost while the peer is answering, so
+// consecutive timeouts back the budget down to this floor and any byte from the peer restores it.
+unsigned linkStallFloorUs() {
+    static const unsigned v = [] {
+        const char *e = std::getenv("PCSX_LINK_STALL_FLOOR_US");
+        return e && *e ? static_cast<unsigned>(std::strtoul(e, nullptr, 10)) : 200u;
+    }();
+    return v;
+}
+unsigned stallTimeoutsBeforeBackoff() {
+    static const unsigned v = [] {
+        const char *e = std::getenv("PCSX_LINK_STALL_BACKOFF_AFTER");
+        return e && *e ? static_cast<unsigned>(std::strtoul(e, nullptr, 10)) : 8u;
+    }();
+    return v;
+}
+
+// Backing off is self-reinforcing without this: a transfer starting while the budget sits at the
+// floor gets replies that arrive after the floor expires, which counts as another timeout, so the
+// budget never recovers and link setup dies. Every Nth stall while backed off therefore waits the
+// full budget as a probe — long enough for a real reply to land, which restores the budget in full.
+// Idle then costs roughly floor + full/N per stall instead of the full budget.
+unsigned stallProbeEvery() {
+    static const unsigned v = [] {
+        const char *e = std::getenv("PCSX_LINK_STALL_PROBE_EVERY");
+        unsigned n = e && *e ? static_cast<unsigned>(std::strtoul(e, nullptr, 10)) : 16u;
+        return n ? n : 1u;
+    }();
+    return v;
+}
+
+// The discriminator that a budget cannot be: wait only when the program is actually mid-block, i.e.
+// it has transmitted since the last byte the peer sent, so a reply is genuinely outstanding. Idle
+// polling of SIO_STAT to notice a partner transmits nothing and so should never cost wall time.
+bool requireTxOutstanding() {
+    static const bool v = [] {
+        const char *e = std::getenv("PCSX_LINK_STALL_REQUIRE_TX");
+        return e && *e && std::strtoul(e, nullptr, 10) != 0;
+    }();
+    return v;
+}
+
+// Ceiling on the share of wall time stalling may consume, which is what actually bounds emulation
+// speed. Per-stall budgets cannot bound it: when both ends poll the port they exchange just enough
+// line-state traffic to look responsive to each other, so neither backs off and both spend the whole
+// wall clock waiting. Capping the aggregate keeps a floor under emulation speed whatever the peer
+// does, while still letting individual waits run their full budget when the allowance permits.
+// 100 (off) by default: capping the aggregate starves a handshake that legitimately needs most of
+// the wall clock, and a failed handshake is worse than a slow one. Kept for experiments.
+unsigned stallMaxSharePercent() {
+    static const unsigned v = [] {
+        const char *e = std::getenv("PCSX_LINK_STALL_MAX_SHARE");
+        unsigned p = e && *e ? static_cast<unsigned>(std::strtoul(e, nullptr, 10)) : 100u;
+        return p > 100 ? 100u : p;
+    }();
+    return v;
+}
+constexpr auto kShareWindow = std::chrono::milliseconds(500);
+
+// The peer's writer advances only on a DSR edge, which its counterpart's *emulated driver* produces
+// after consuming a block. That makes every acknowledgement depend on the far side advancing emulated
+// time — which its own stall forbids, so both ends withhold exactly the progress the other needs and
+// the link livelocks at a fraction of a frame per second. Acknowledging from the transport the moment
+// a block lands puts the edge back on the wire one network round trip away and takes emulation out of
+// the loop. Bytes still reach the program at the emulated baud rate via the RX pacing, so the stream
+// it observes is unchanged; only the acknowledgement stops waiting for a frozen clock.
+bool localAckEnabled() {
+    static const bool v = [] {
+        const char *e = std::getenv("PCSX_LINK_LOCAL_ACK");
+        return e && *e && std::strtoul(e, nullptr, 10) != 0;
+    }();
+    return v;
+}
+// Bound on how far the peer may run ahead. An unwindowed transport ack tells the peer a block was
+// consumed before the program has read it, so the peer races on and the two sides diverge exactly at a
+// handoff like match start (observed: receive backlog growing to 55 bytes against a hardware depth of
+// 8). Acknowledging only while the backlog is within what real hardware could hold keeps the livelock
+// cure and lets driver-produced acks govern once the program is genuinely behind.
+unsigned ackWindowBytes() {
+    static const unsigned v = [] {
+        const char *e = std::getenv("PCSX_LINK_ACK_WINDOW");
+        return e && *e ? static_cast<unsigned>(std::strtoul(e, nullptr, 10)) : 8u;
+    }();
+    return v;
+}
+unsigned ackBlockBytes() {
+    static const unsigned v = [] {
+        const char *e = std::getenv("PCSX_LINK_ACK_BLOCK");
+        unsigned n = e && *e ? static_cast<unsigned>(std::strtoul(e, nullptr, 10)) : 4u;
+        return n ? n : 1u;
+    }();
+    return v;
+}
+
+}  // namespace
+
+uint64_t PCSX::SIO1::diagCycle() { return g_emulator->m_cpu->m_regs.cycle; }
+
+// Returns whether this event should be logged, announcing the cutoff exactly once so that
+// a missing log line can always be distinguished from an event that did not happen.
+bool PCSX::SIO1::diagBudget(unsigned &counter, const char *what) {
+    if (++counter < kDiagCap) return true;
+    if (counter == kDiagCap) {
+        g_system->printf("SIO1-DIAG t=%10.3f LOG CAP REACHED for %s after %u events; further ones NOT logged\n",
+                         diagMs(), what, kDiagCap);
+    }
+    return false;
+}
+
+// The link socket lives on the main loop, which the UI pumps once per rendered frame. A protocol
+// that acknowledges every block then pays a frame period per acknowledgement, which dominates
+// everything else. Servicing the loop here, on each hsync, carries a message in about a scanline.
+//
+// While the program is spinning on SIO_STAT waiting for the far end, also spend a bounded slice of
+// *wall* time waiting for the peer instead of letting emulated time run on. On real hardware a
+// block acknowledgement costs a byte time; across two processes it costs a host round trip, and if
+// emulated time advances meanwhile the program sees a delay far longer than its driver tolerates.
+// Stalling here keeps the two clocks aligned; the bound means a peer that never answers only ever
+// costs this much per scanline.
+void PCSX::SIO1::pumpTransport() {
+    static const bool announced = [] {
+        g_system->printf("SIO1-DIAG t=%10.3f LINK TUNING stallUs=%u pollCycles=%llu\n", diagMs(),
+                         linkStallUs(), (unsigned long long)pollingWindowCycles());
+        return true;
+    }();
+    (void)announced;
+    ++m_pumpCalls;
+    ++m_uvRuns;
+    uv_run(g_system->getLoop(), UV_RUN_NOWAIT);
+    if (!m_fifo) return;
+    // Halved rather than cleared: a single byte does not prove the peer is transferring, and clearing
+    // makes every trickle of line-state traffic re-pay a full run of timeouts before backing off.
+    if (m_fifo->size() != 0) {
+        m_stallTimeouts /= 2;
+        m_awaitingReply = false;  // the peer answered: nothing is outstanding until we transmit again
+        return;
+    }
+    // Only when the program is actively polling the port, i.e. blocked on the link.
+    if (diagCycle() - m_lastStatReadCycle > pollingWindowCycles()) return;
+    if (requireTxOutstanding() && !m_awaitingReply) return;
+
+    // Spend no more than the allowed share of any window on stalling, so emulation keeps a speed
+    // floor even when the peer answers every time and no per-stall budget is ever exceeded.
+    static auto shareWindowStart = std::chrono::steady_clock::now();
+    static uint64_t shareStallUs = 0;
+    auto now = std::chrono::steady_clock::now();
+    if (now - shareWindowStart >= kShareWindow) {
+        shareWindowStart = now;
+        shareStallUs = 0;
+    }
+    uint64_t windowUs = std::chrono::duration_cast<std::chrono::microseconds>(now - shareWindowStart).count();
+    if (stallMaxSharePercent() < 100 &&
+        shareStallUs * 100 > uint64_t(stallMaxSharePercent()) * (windowUs ? windowUs : 1)) {
+        ++m_stallsSkipped;
+        return;
+    }
+
+    if (m_stallTimeouts < stallTimeoutsBeforeBackoff()) {
+        m_stallBudgetUs = linkStallUs();
+    } else {
+        // Backed off, but probe with the full budget periodically so a starting transfer is noticed.
+        m_stallBudgetUs = (++m_stallsWhileBackedOff % stallProbeEvery()) == 0 ? linkStallUs() : linkStallFloorUs();
+    }
+    ++m_stallEntries;
+    auto deadline = now + std::chrono::microseconds(m_stallBudgetUs);
+    while (m_fifo->size() == 0 && std::chrono::steady_clock::now() < deadline) {
+        ++m_uvRuns;
+        uv_run(g_system->getLoop(), UV_RUN_NOWAIT);
+    }
+    if (m_fifo->size() == 0) {
+        ++m_stallTimeouts;
+    } else {
+        m_stallTimeouts /= 2;
+    }
+    uint64_t spentUs =
+        std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() - now).count();
+    m_stallWallUs += spentUs;
+    shareStallUs += spentUs;
+}
+
+// Attributes wall time while the link is up: emulated speed against the host clock, and how much of
+// that wall time the blocked-peer stall actually accounts for. Reported on a wall-clock interval
+// rather than an emulated one — an emulated-time trigger reports exactly as rarely as a stalled
+// emulator allows, which is the case most in need of a number. Counters are cumulative; each line
+// states the delta since the previous line, so no line is ambiguous with truncation.
+void PCSX::SIO1::speedTick() {
+    constexpr auto kReportInterval = std::chrono::seconds(2);
+    constexpr double kPsxClockKHz = 33868.8;
+    static auto lastWall = std::chrono::steady_clock::now();
+    static uint64_t lastCycle = 0, lastFrames = 0, lastPumps = 0, lastUvRuns = 0, lastStalls = 0, lastStallUs = 0,
+                    lastSkipped = 0, lastTx = 0, lastAcks = 0;
+    static uint64_t frames = 0;
+    static bool primed = false;
+
+    ++frames;
+    auto now = std::chrono::steady_clock::now();
+    if (now - lastWall < kReportInterval) return;
+    uint64_t cyc = diagCycle();
+    double wallMs = std::chrono::duration<double, std::milli>(now - lastWall).count();
+    if (!primed) {  // first interval has no baseline cycle to difference against
+        primed = true;
+    } else {
+        g_system->printf(
+            "SIO1-DIAG t=%10.3f cyc=%llu SPEED %.2f%% emuFps=%.2f wallMs=%.1f frames=%llu "
+            "pumps=%llu uvRuns=%llu stalls=%llu skipped=%llu stallMs=%.1f (%.1f%% of wall) budgetUs=%u "
+            "timeouts=%u tx=%llu awaiting=%d acks=%llu\n",
+            diagMs(), (unsigned long long)cyc, (cyc - lastCycle) / (kPsxClockKHz * wallMs) * 100.0,
+            (frames - lastFrames) * 1000.0 / wallMs, wallMs, (unsigned long long)(frames - lastFrames),
+            (unsigned long long)(m_pumpCalls - lastPumps), (unsigned long long)(m_uvRuns - lastUvRuns),
+            (unsigned long long)(m_stallEntries - lastStalls), (unsigned long long)(m_stallsSkipped - lastSkipped),
+            (m_stallWallUs - lastStallUs) / 1000.0,
+            (m_stallWallUs - lastStallUs) / 10.0 / wallMs, m_stallBudgetUs, m_stallTimeouts,
+            (unsigned long long)(m_txEvents - lastTx), (int)m_awaitingReply,
+            (unsigned long long)(m_syntheticAcks - lastAcks));
+    }
+    lastWall = now;
+    lastCycle = cyc;
+    lastFrames = frames;
+    lastPumps = m_pumpCalls;
+    lastUvRuns = m_uvRuns;
+    lastStalls = m_stallEntries;
+    lastStallUs = m_stallWallUs;
+    lastSkipped = m_stallsSkipped;
+    lastTx = m_txEvents;
+    lastAcks = m_syntheticAcks;
+}
+
+void PCSX::SIO1::setDsr(bool value) {
+    bool was = !!(m_regs.status & SR_DSR);
+    if (value) {
+        m_regs.status |= SR_DSR;
+    } else {
+        m_regs.status &= ~SR_DSR;
+    }
+    if (was == value) return;
+    m_lineChangedThisDrain = true;
+    if (value) {
+        m_dsrRiseCycle = diagCycle();
+        m_dsrRiseStatReads = m_statReadsWithDsr;
+        g_system->printf("SIO1-DIAG t=%10.3f cyc=%llu DSR 0->1\n", diagMs(), (unsigned long long)diagCycle());
+        // The hardware raises an interrupt while DSR is high if CTRL.12 asks for one. Sony's
+        // LIBCOMB driver sleeps on exactly this; a driver that never enables bit 12 never takes
+        // this path, so polling drivers are unaffected.
+        if ((m_regs.control & CR_DSRIRQEN) && !(m_regs.status & SR_IRQ)) {
+            m_regs.status |= SR_IRQ;
+            scheduleInterrupt(m_cycleCount);
+            g_system->printf("SIO1-DIAG t=%10.3f cyc=%llu DSR IRQ raised (ctrl=%04x)\n", diagMs(),
+                             (unsigned long long)diagCycle(), m_regs.control);
+        }
+    } else {
+        g_system->printf("SIO1-DIAG t=%10.3f cyc=%llu DSR 1->0 held=%llu cyc, game STAT reads while high=%u\n",
+                         diagMs(), (unsigned long long)diagCycle(),
+                         (unsigned long long)(diagCycle() - m_dsrRiseCycle), m_statReadsWithDsr - m_dsrRiseStatReads);
+    }
+}
+
+void PCSX::SIO1::setCts(bool value) {
+    bool was = !!(m_regs.status & SR_CTS);
+    if (value) {
+        m_regs.status |= SR_CTS;
+    } else {
+        m_regs.status &= ~SR_CTS;
+    }
+    flushTxHold();
+    if (was == value) return;
+    m_lineChangedThisDrain = true;
+    if (value) {
+        m_ctsRiseCycle = diagCycle();
+        m_ctsRiseStatReads = m_statReadsWithCts;
+        g_system->printf("SIO1-DIAG t=%10.3f cyc=%llu CTS 0->1\n", diagMs(), (unsigned long long)diagCycle());
+    } else {
+        g_system->printf("SIO1-DIAG t=%10.3f cyc=%llu CTS 1->0 held=%llu cyc, game STAT reads while high=%u\n",
+                         diagMs(), (unsigned long long)diagCycle(),
+                         (unsigned long long)(diagCycle() - m_ctsRiseCycle), m_statReadsWithCts - m_ctsRiseStatReads);
+    }
+}
+
+// Retaliation's link driver keeps the DSR level it last acted on at 0x801F85E8 and advances
+// only when the live DSR differs from it. Reading emulated RAM directly (rather than inferring
+// from the program counter, which the dynarec reports per-block) shows exactly which level each
+// side latched and when, against the DSR it was actually seeing.
+void PCSX::SIO1::watchLinkBaseline() {
+    uint8_t *wram = g_emulator->m_mem->m_wram;
+    if (!wram) return;
+    uint32_t w[4], r[4];
+    memcpy(w, wram + (kLinkStateAddr & 0x1fffff), sizeof(w));
+    memcpy(r, wram + (kReadStateAddr & 0x1fffff), sizeof(r));
+    bool dsr = m_regs.status & SR_DSR;
+    bool wChanged = memcmp(w, m_lastLinkState, sizeof(w)) != 0;
+    bool rChanged = memcmp(r, m_lastReadState, sizeof(r)) != 0;
+    if (!wChanged && !rChanged && dsr == m_lastLinkBaselineDsr) return;
+
+    // The block size gates every handshake: the writer waits for a DSR edge after this many
+    // bytes, and the reader toggles DTR after the same count.
+    uint16_t cfg = 0;
+    memcpy(&cfg, wram + (kLinkConfigAddr & 0x1fffff), sizeof(cfg));
+    uint32_t idx = (cfg & 0x300) >> 7;
+    int16_t block = 0;
+    memcpy(&block, wram + ((0x801ace30 + idx) & 0x1fffff), sizeof(block));
+
+    g_system->printf(
+        "SIO1-DIAG t=%10.3f cyc=%llu LINKSTATE WR[act=%08x buf=%08x cnt=%08x latch=%08x] "
+        "RD[act=%08x buf=%08x cnt=%08x] block=%d cfg=%04x DSR=%d DTR=%d stat=%04x ctrl=%04x fifo=%zu\n",
+        diagMs(), (unsigned long long)diagCycle(), w[0], w[1], w[2], w[3], r[0], r[1], r[2], block, cfg, dsr,
+        !!(m_regs.control & CR_DTR), m_regs.status, m_regs.control, m_sio1fifo ? m_sio1fifo->size() : 0);
+    memcpy(m_lastLinkState, w, sizeof(w));
+    memcpy(m_lastReadState, r, sizeof(r));
+    m_lastLinkBaselineDsr = dsr;
+}
+
+// A drain that consumes several messages in one poll applies all their line transitions
+// between two emulated instructions, so the game cannot observe any but the last.
+void PCSX::SIO1::logDrain() {
+    g_system->printf("SIO1-DIAG t=%10.3f cyc=%llu DRAIN %u messages in one poll\n", diagMs(),
+                     (unsigned long long)diagCycle(), m_msgsThisDrain);
+}
+
+// Status polling is the game's only view of DSR/CTS, so every read is counted, but only
+// changes in the observed value are printed.
+void PCSX::SIO1::logStatRead() {
+    watchLinkBaseline();
+    m_lastStatReadCycle = diagCycle();
+    m_statReads++;
+    if (m_regs.status & SR_DSR) m_statReadsWithDsr++;
+    if (m_regs.status & SR_CTS) m_statReadsWithCts++;
+
+    // Where the polling loop lives. Sampled, because this is a high-volume success event and the
+    // loop repeats from the same address; the change-triggered line below is the uncapped record.
+    if ((m_statReads & 0xfff) == 0) {
+        g_system->printf("SIO1-DIAG t=%10.3f cyc=%llu STAT poll sample pc=%08x stat=%04x reads=%u\n", diagMs(),
+                         (unsigned long long)diagCycle(), g_emulator->m_cpu->m_regs.pc, m_regs.status, m_statReads);
+    }
+
+    if (m_regs.status == m_lastLoggedStat && m_regs.control == m_lastLoggedStatCtrl) {
+        m_statRepeats++;
+        return;
