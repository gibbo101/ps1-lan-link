+#pragma once
+
+#include <atomic>
+#include <condition_variable>
+#include <cstdint>
+#include <deque>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include "support/slice.h"
+
+namespace PCSX {
+
+// Publishes finished frames and mixed audio to a local consumer over a unix domain socket, so a
+// windowless instance can be watched and heard elsewhere.
+//
+// The socket is deliberately local-only. The consumer is a separate process that owns encoding and
+// whatever it puts on the network; nothing here listens on a network address, and this channel
+// carries only pixels and samples — never the emulator's Lua, memory or file surfaces.
+//
+// Producers run on the emulation thread (video) and the audio device thread (audio). Neither may
+// ever block on the consumer: both hand their data to bounded queues that drop, and count, when the
+// consumer cannot keep up. The exporter thread does all of the I/O and holds no lock while writing.
+class MediaStream {
+  public:
+    struct AudioFrame {
+        int16_t L = 0, R = 0;
+    };
+
+    // How the payload of a video packet is laid out. Both come straight out of VRAM: BGR555 is a
+    // little-endian 16-bit word per pixel with the top bit as the mask bit, RGB888 is the 24bpp
+    // display mode used by FMV.
+    enum class VideoFormat : uint8_t { BGR555 = 0, RGB888 = 1 };
+
+    static MediaStream &get();
+
+    // Binds and listens on socketPath, replacing any stale socket left by a previous run, and
+    // starts the exporter thread. A failure to bind disables the stream and leaves the emulator
+    // running: a missing stream is a degraded instance, not a dead one.
+    void start(const std::string &socketPath);
+    void stop();
+
+    bool enabled() const { return m_enabled.load(std::memory_order_relaxed); }
+    // True only while a consumer is attached. Producers test this before doing any work at all, so
+    // an instance nobody is watching pays nothing beyond the load.
+    bool wants() const { return m_wants.load(std::memory_order_relaxed); }
+
+    // Takes ownership of the pixel buffer. Called on the emulation thread once per displayed frame.
+    void pushVideo(Slice &&pixels, uint16_t width, uint16_t height, VideoFormat format);
+    // Called on the audio device thread with the mix that would otherwise reach the speakers.
+    void pushAudio(const AudioFrame *frames, size_t count, uint32_t sampleRate);
+
+    // Emits the STREAM diagnostic line on a wall-clock interval. Called from the emulation thread.
+    void tick();
+
+    static constexpr uint32_t kHelloMagic = 0x534c3150;   // "P1LS"
+    static constexpr uint32_t kPacketMagic = 0x4b503150;  // "P1PK"
+    static constexpr uint16_t kVersion = 1;
+
+    enum class PacketType : uint8_t { Video = 1, Audio = 2 };
+
+    // Both structs are written and read as little-endian, which is what every host this runs on is.
+    struct Hello {
+        uint32_t magic;
+        uint16_t version;
+        uint16_t headerSize;
+        uint32_t audioRate;
+        uint16_t audioChannels;
+        uint16_t videoMaxWidth;
+        uint16_t videoMaxHeight;
+        uint16_t reserved;
+        uint32_t flags;
+    };
+    static_assert(sizeof(Hello) == 24);
+
+    struct PacketHeader {
+        uint32_t magic;
+        uint8_t type;
+        uint8_t format;
+        uint16_t width;   // audio: channel count
+        uint16_t height;  // audio: frame count
+        uint16_t aux;     // audio: sample rate in Hz; video: unused
+        uint32_t payloadLen;
+        uint64_t timestampUs;  // monotonic, taken when the producer handed the data over
+    };
+    static_assert(sizeof(PacketHeader) == 24);
+
+  private:
+    MediaStream() = default;
+    ~MediaStream() { stop(); }
+    MediaStream(const MediaStream &) = delete;
+    MediaStream &operator=(const MediaStream &) = delete;
+
+    struct VideoItem {
+        Slice data;
+        uint16_t width = 0, height = 0;
+        VideoFormat format = VideoFormat::BGR555;
+        uint64_t timestampUs = 0;
+    };
+    struct AudioItem {
+        std::vector<AudioFrame> frames;
+        uint32_t sampleRate = 0;
+        uint64_t timestampUs = 0;
+    };
+
+    void run();
+    void normalize(const VideoItem &item, std::vector<uint8_t> &out);
+    bool acceptClient(int listenFd);
+    void dropClient(const char *why);
+    void serialize(std::deque<VideoItem> &video, std::deque<AudioItem> &audio);
+    void enqueueOut(std::vector<uint8_t> &&packet);
+    bool flushOut();
+    void trimOut();
+    uint64_t nowUs() const;
+
+    // Every frame leaves at this size and in this format, whatever the PS1 was displaying. The
+    // console changes resolution and bit depth as it runs — 320x240 24bpp for FMV, 512x240 16bpp
+    // for menus — and a consumer that has to follow those changes must rebuild its decoder each
+    // time, which produces flashing, gaps in the audio and resets of the stream's clock.
+    //
+    // The size and format are chosen for bytes per second, not for fidelity. 512x240 in the
+    // console's own 16bpp is ~15 MB/s, which the consumer drains comfortably; normalising to
+    // 640x480 RGB24 instead was ~53 MB/s and the consumer could not keep up, so frames and audio
+    // were dropped and the result was worse than doing nothing. Upscaling belongs in the encoder,
+    // which does it for free on the way to h264.
+    static constexpr uint16_t kOutWidth = 512;
+    static constexpr uint16_t kOutHeight = 240;
+    static constexpr VideoFormat kOutFormat = VideoFormat::BGR555;
+
+    // A frame every 16.6 ms against a consumer that reads promptly: three slots absorb a scheduling
+    // hiccup, and anything past that is better dropped than queued into latency.
+    static constexpr size_t kMaxVideoQueued = 3;
+    // A quarter of a second of 44.1 kHz stereo. Past this the consumer is not coming back.
+    static constexpr size_t kMaxAudioFramesQueued = 11025;
+    // Ceiling on bytes waiting for a socket that is not draining. Roughly four full 24bpp frames.
+    static constexpr size_t kMaxOutBytes = 4 * 1024 * 1024;
+
+    std::atomic<bool> m_enabled{false};
+    std::atomic<bool> m_wants{false};
+    std::atomic<bool> m_quit{false};
+    std::string m_socketPath;
+    int m_listenFd = -1;
+    int m_clientFd = -1;
+    std::thread m_thread;
+
+    std::mutex m_mutex;
+    std::condition_variable m_cv;
+    std::deque<VideoItem> m_video;
+    std::deque<AudioItem> m_audio;
+    size_t m_audioFramesQueued = 0;
+
+    // Owned by the exporter thread alone; the two sizes are atomic only so the diagnostic line can
+    // read them from the emulation thread.
+    std::deque<std::vector<uint8_t>> m_out;
+    std::atomic<size_t> m_outBytes{0};
+    std::atomic<size_t> m_outPackets{0};
+    size_t m_outOffset = 0;
+
+    // Cumulative and uncapped, so a rate can always be differenced out of two lines and an absence
+    // of failures is never an artefact of a counter that stopped counting.
+    std::atomic<uint64_t> m_videoPushed{0};
+    std::atomic<uint64_t> m_videoDropped{0};
+    std::atomic<uint64_t> m_videoQueued{0};
+    std::atomic<uint64_t> m_audioFramesPushed{0};
+    std::atomic<uint64_t> m_audioFramesDropped{0};
+    std::atomic<uint64_t> m_audioPacketsSent{0};
+    std::atomic<uint64_t> m_bytesSent{0};
+    std::atomic<uint64_t> m_outDropped{0};
+    std::atomic<uint64_t> m_connects{0};
+    std::atomic<uint64_t> m_disconnects{0};
+    std::atomic<uint64_t> m_pushMaxUs{0};
+    std::atomic<uint32_t> m_audioRate{0};
+};
+
+}  // namespace PCSX
