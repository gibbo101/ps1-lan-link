# Leading slashes are load-bearing: these rules must match only the repo root, never a directory of
# the same name nested under deploy/.

# Disc images, BIOS and extracted executables — copyrighted and multi-GB.
/work/

# BIOS and discs are never redistributable, wherever they happen to land. Matching by extension as
# well as by directory means a stray image cannot be swept in by `git add -A`.
bios/
roms/
*.bin
*.img
*.iso
*.cue
*.ecm
*.mcd
*.AppImage

# Upstream clone with its own history, plus build output. Our changes live in patches/.
/pcsx-redux/

/venv/
__pycache__/
*.pyc

# Raw emulator logs run to tens of MB. The SPEED extracts in docs/session7-evidence are the evidence.
docs/session7-evidence/*-run.log
*.stale

# Built by deploy/deck/stream/player/build.sh from the .c beside it.
/deploy/deck/stream/player/ps1-join-player
/deploy/deck/menu/ps1-link-menu
